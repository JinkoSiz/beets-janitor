# Скопировать в .env и заполнить. Всё, кроме ключей Spotify, необязательно:
# значения по умолчанию совпадают с раскладкой образа linuxserver/beets.

# --- Spotify -----------------------------------------------------------------
# https://developer.spotify.com/dashboard -> Create app.
# Без них плагин Spotify молча не находит ничего.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Пути --------------------------------------------------------------------
# MUSIC_DIR=/music         # фонотека
# INCOMING_DIR=/incoming   # куда падают новые файлы
# RESIDUE_DIR=/residue     # карантин: убранные копии и битые файлы
# CONFIG_DIR=/config       # конфиги, база, журналы
# BEETSDIR=/config         # где beets ищет свой config.yaml (по умолчанию = CONFIG_DIR)

# --- Раскладка фонотеки ------------------------------------------------------
# Папки-свалки: там лежат одиночные файлы, а не собранные альбомы. Дедуп
# обращается с ними мягче — лишнюю копию из свалки убрать можно, а выдернуть
# дорожку из собранного альбома нельзя.
# LOOSE_DIRS=Non-Album,TelegramMusic,_Unofficial,_Unmatched

# --- Поведение ---------------------------------------------------------------
# INTERVAL=300             # как часто проверять incoming, секунд
# NIGHTLY_HOUR=5           # с какого часа пытаться начать ночную работу
# JUNK_DAYS=3              # сколько хранить мусор в карантине
# DUPES_DAYS=14            # сколько хранить убранные копии (запас на откат)
# TMO_ALBUM=900            # потолок времени на импорт одной папки, секунд
# TMO_SINGLE=300           # то же для одиночного файла
# SPOTIFY_DAILY=2500       # дневной потолок запросов к Spotify
# OWNER=1000:1000          # chown фонотеки после работы; пусто — не трогать
# SPOOL_DIR=               # если задать, сюда лягут сводки для уведомлялки
# FPCALC=fpcalc            # путь к fpcalc из chromaprint, если он не в PATH
